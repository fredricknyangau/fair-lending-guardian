# Groq API Key (https://console.groq.com) — optional if using gemini
GROQ_API_KEY=your_groq_api_key_here

# Google API Key (https://aistudio.google.com/app/apikey) — required for gemini
GOOGLE_API_KEY=your_google_api_key_here

# LLM Provider: 'groq' or 'gemini' (default: gemini)
LLM_PROVIDER=gemini
