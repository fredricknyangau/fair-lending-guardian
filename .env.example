# ─── LLM Provider ────────────────────────────────────────────────────────────
# Set ONE of the providers below and supply the matching API key.
# Supported values: groq | gemini | ollama | cohere | cerebras
LLM_PROVIDER=gemini
# Fallback chain: comma-separated providers tried in order when primary
# hits a rate limit or transient error. Leave empty to disable.
# Example: LLM_FALLBACK_CHAIN=groq,ollama
LLM_FALLBACK_CHAIN=

# ─── Groq (https://console.groq.com) ─────────────────────────────────────────
# Free tier: 60 req/min · 6 000 req/day · llama-3.1-8b-instant
GROQ_API_KEY=your_groq_api_key_here

# ─── Google Gemini (https://aistudio.google.com/app/apikey) ──────────────────
# Free tier: 60 req/min · 1 500 req/day · gemini-2.5-flash
GOOGLE_API_KEY=your_google_api_key_here

# ─── Ollama (https://ollama.com) — local, zero rate limits ───────────────────
# Run locally: ollama pull mistral && ollama serve
# No API key needed. Override base URL only if Ollama isn't on localhost:11434.
# OLLAMA_API_BASE=http://localhost:11434

# ─── Cohere (https://dashboard.cohere.com/api-keys) ─────────────────────────
# Free trial: 1 000 req/month · command-a-03-2025 model (command-r was removed Sep 2025)
COHERE_API_KEY=your_cohere_api_key_here

# ─── Cerebras (https://cloud.cerebras.ai) ────────────────────────────────────
# Free tier · very fast · Llama 3.1 8B on custom silicon · OpenAI-compatible
CEREBRAS_API_KEY=your_cerebras_api_key_here
